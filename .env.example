# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (configured in Supabase Auth → Providers, credentials come
# from Google Cloud Console — not read directly by the app, listed here so
# the full auth setup is documented in one place)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Email provider for goal nudges — set once one is chosen (see README).
# EMAIL_PROVIDER_API_KEY=
