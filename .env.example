# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (configured in Supabase Auth → Providers, credentials come
# from Google Cloud Console — not read directly by the app, listed here so
# the full auth setup is documented in one place)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Email provider for goal nudges (src/lib/notifications). Falls back to
# console logging locally if unset — see src/lib/notifications/index.ts.
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=

# Secret the daily nudge cron (vercel.json -> /api/cron/nudges) must send
# as `Authorization: Bearer <value>`. Vercel Cron sets this automatically
# when CRON_SECRET is set as a project env var.
# CRON_SECRET=

# Used to build links in nudge emails and OAuth redirects. Defaults to
# http://localhost:3000 if unset.
# NEXT_PUBLIC_SITE_URL=
